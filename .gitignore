# =============================================================================
# KickStream Shorts Studio - Git Ignore Configuration
# =============================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Environment & Sensitive Credentials ---
.env
.env.local
.env.*.local
credentials/*.json
!credentials/client_secret.json.example

# --- FFmpeg & Heavy Binaries (>100MB rejected by GitHub) ---
bin/*.exe
bin/*.dll
bin/*.zip
bin/*.tar.gz
!bin/.gitkeep

# --- Runtime Working Directories & Output Media ---
output/*
!output/.gitkeep
temp/*
!temp/.gitkeep

# --- Test Caches & Coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- IDE & Editor Artifacts ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- OS-Generated Junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
